<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HoponAdminCreatedRestaurantOrderThenSuspendSuite" preserve-order="true">

    <!-- Runs in listed order: full order lifecycle first (creates the restaurant via
         admin-portal-automation and writes admin-portal-automation/target/last-created-restaurant.properties),
         then the suspend test, which reads that same handoff file (AdminCreatedRestaurant.latest())
         so it targets the exact restaurant the order flow just used. -->
    <test name="AdminCreatedRestaurantOrderThenSuspend" preserve-order="true">
        <classes>
            <class name="WebFunctionalTests.EndToEnd.AdminCreatedRestaurantOrderLifecycleTest"/>
            <class name="WebFunctionalTests.EndToEnd.AdminCreatedRestaurantSuspendTest"/>
        </classes>
    </test>

</suite>
