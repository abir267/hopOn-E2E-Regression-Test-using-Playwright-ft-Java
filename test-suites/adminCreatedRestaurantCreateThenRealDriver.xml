<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HoponAdminCreatedRestaurantCreateThenRealDriverSuite" preserve-order="true">

    <!-- Full flow with the REAL driver app on the USB-attached phone (adb) instead of DriverAPI, in this order:
           1. AdminCreatedRestaurantCreateTest      creates a NEW restaurant + category + food via admin-portal-automation and
                                                    writes admin-portal-automation/target/last-created-restaurant.properties
           2. AdminCreatedRestaurantRealDriverTest  orders from it (customer chat, restaurant, real driver app: accept ->
                                                    arrived -> chat -> pickup PIN -> photo proof -> delivered), then turns the
                                                    restaurant off and deactivates it
           3. AdminCreatedRestaurantSuspendTest     suspends that same restaurant in the Hop On Admin Management portal
         Steps 2 and 3 read the same hand-off file (AdminCreatedRestaurant.latest()), so they target the restaurant step 1
         just made - like the lifecycle-then-suspend suite. Steps run even if an earlier one fails, so the file is what ties
         them together; step 3 suspends whatever restaurant is in it. To reuse the last restaurant instead of creating one,
         run adminCreatedRestaurantRealDriver.xml.
         Run (PowerShell needs the quotes):
           mvn test "-DsuiteXmlFile=test-suites/adminCreatedRestaurantCreateThenRealDriver.xml" -->
    <test name="AdminCreatedRestaurantCreateThenRealDriver" preserve-order="true">
        <classes>
            <class name="WebFunctionalTests.EndToEnd.AdminCreatedRestaurantCreateTest"/>
            <class name="WebFunctionalTests.EndToEnd.AdminCreatedRestaurantRealDriverTest"/>
            <class name="WebFunctionalTests.EndToEnd.AdminCreatedRestaurantSuspendTest"/>
        </classes>
    </test>

</suite>
