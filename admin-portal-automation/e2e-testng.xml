<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Restaurant End To End" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="com.hopon.listeners.ExtentReportListener"/>
    </listeners>
    <test name="Create restaurant, login, category, food" preserve-order="true">
        <classes>
            <class name="com.hopon.tests.CreateRestaurantTest"/>
            <class name="com.hopon.tests.RestaurantLoginTest"/>
            <class name="com.hopon.tests.AddCategoryTest"/>
            <class name="com.hopon.tests.CreateFoodTest"/>
        </classes>
    </test>
</suite>